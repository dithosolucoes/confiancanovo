# Assistente IA (Google Gemini). Sem chave, o chat mostra "não configurado".
GEMINI_API_KEY=
# Modelo opcional (padrão: gemini-2.5-flash)
GEMINI_MODEL=

# Produção: NODE_ENV=production desliga o login sem senha (demo-login) e a confirmação manual de pagamento.
# STRIPE_WEBHOOK_SECRET é obrigatório quando STRIPE_SECRET_KEY estiver definido (sem ele o webhook recusa tudo).
NODE_ENV=production

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Session signing secret (generate strong random string in production)
SESSION_SECRET=

# Production PostgreSQL / Supabase connection (SQLite confianca.db used locally when unset)
DATABASE_URL=

# Optional external integrations (preview falls back cleanly when unset)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL="Confiança Repara <no-reply@confiancamanutencao.com>"
GOOGLE_MAPS_API_KEY=
GOOGLE_CALENDAR_CLIENT_ID=
